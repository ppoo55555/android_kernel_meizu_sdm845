        pins = "gpio80";
    };

    config {
        pins = "gpio80";
    };
};

&cam_sensor_rear_suspend {
    mux {
        pins = "gpio80";
    };

    config {
        pins = "gpio80";
    };
};

&cam_sensor_front_active {
    mux {
        pins = "gpio9";
    };

    config {
        pins = "gpio9";
    };
};

&cam_sensor_front_suspend {
    mux {
        pins = "gpio9";
    };

    config {
        pins = "gpio9";
    };
};

&cam_sensor_rear2_active {
    mux {
        pins = "gpio23";
    };

    config {
        pins = "gpio23";
    };
};

&cam_sensor_rear2_suspend {
    mux {
        pins = "gpio23";
    };

    config {
        pins = "gpio23";
    };
};

&cam_sensor_rear_vana {
    mux {
        pins = "gpio90";
    };

    config {
        pins = "gpio90";
    };
};

&cam_res_mgr_active {
    mux {
        pins = "gpio90";
    };

    config {
        pins = "gpio90";
    };
};

&cam_res_mgr_suspend {
    mux {
        pins = "gpio90";
    };

    config {
        pins = "gpio90";
    };
};

&qupv3_se9_2uart_active {
    config {
        bias-pull-down;
    };
};

&qupv3_se9_2uart_sleep {
    config {
        bias-pull-down;
    };
};

&key_cam_focus_default {
    pins = "gpio90";
};

&nfc_int_active {
    mux {
        pins = "gpio127";
    };

    config {
        pins = "gpio127";
    };
};

&nfc_int_suspend {
    mux {
        pins = "gpio127";
    };

    config {
        pins = "gpio127";
    };
};

&cam_sensor_iris_suspend {
    config {
        bias-disable;
    };
};

&cci0_active {
    config {
        bias-disable;
    };
};

&cci0_suspend {
    config {
        bias-pull-up;
    };
};

&cci1_active {
    config {
        bias-disable;
    };
};

&cci1_suspend {
    config {
        bias-pull-up;
    };
};

&pcie0_clkreq_default {
    mux {
        /delete-property/ pins;
        /delete-property/ function;
    };

    config {
        /delete-property/ pins;
        /delete-property/ drive-strength;
        /delete-property/ bias-pull-up;
    };
};
