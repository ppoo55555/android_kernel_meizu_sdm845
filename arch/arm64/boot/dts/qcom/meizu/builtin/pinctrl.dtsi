&tlmm {
    atest_usb13 {
        atest_usb13_active: atest_usb13_active {
            mux {
                pins = "gpio63";
                function = "gpio";
            };
    
            config {
                pins = "gpio63";
                drive-strength = <12>;
                bias-pull-up;
                output-high;
            };
        };
    
        atest_usb13_suspend: atest_usb13_suspend {
            mux {
                pins = "gpio63";
                function = "gpio";
            };
    
            config {
                pins = "gpio63";
                bias-pull-down;
                drive-strength = <2>;
                output-low;
            };
        };
    };

    atest_usb13_oe {
        atest_usb13_oe_active: atest_usb13_oe_active {
            mux {
                pins = "gpio129";
                function = "gpio";
            };

            config {
                pins = "gpio129";
                drive-strength = <2>;
                bias-pull-down;
                output-low;
            };
        };

        atest_usb13_oe_suspend: atest_usb13_oe_suspend {
            mux {
                pins = "gpio129";
                function = "gpio";
            };

            config {
                pins = "gpio129";
                drive-strength = <2>;
                bias-pull-up;
                output-high;
            };
        };
    };

    quat_mi2s_lines {
        quat_mi2s_lines_sleep: quat_mi2s_lines_sleep {
            mux {
                pins = "gpio58", "gpio59", "gpio60", "gpio61";
                function = "gpio";
            };

            config {
                drive-strength = <2>;
                bias-pull-down;
                input-enable;
            };
        };

        quat_mi2s_lines_active: quat_mi2s_lines_active {
            mux {
                pins = "gpio58", "gpio59", "gpio60", "gpio61";
                function = "qua_mi2s";
            };

            config {
                pins = "gpio58", "gpio59", "gpio60", "gpio61";
                drive-strength = <8>;
                bias-disable;
            };
        };
    };

    cam_flash_rear_active: cam_flash_rear_active {
        mux {
            pins = "gpio22";
            function = "gpio";
        };

        config {
            pins = "gpio22";
            bias-disable;
            drive-strength = <2>;
        };
    };

    cam_flash_rear_suspend: cam_flash_rear_suspend {
        mux {
            pins = "gpio22";
            function = "gpio";
        };

        config {
            pins = "gpio22";
            bias-pull-down;
            drive-strength = <2>;
            output-low;
        };
    };

    fusb_irq_pin_input: fusb_irq_pin_input {
        mux {
            pins = "gpio40";
            function = "gpio";
        };
        config {
            pins = "gpio40";
            drive-strength = <2>;
            bias-pull-up;
            input-enable;
        };
    };

    tp_pins_tp_eint_as_int: tp_pins_tp_eint_as_int {
        mux {
            pins = "gpio125";
            function = "gpio";
        };

        config {
            pins = "gpio125";
            bias-pull-up;
        };
    };

    fp_reset_init: fp_reset_init {
        mux {
            pins = "gpio102";
            function = "gpio";
        };

        config {
            pins = "gpio102";
            drive-strength = <2>;
            bias-disable;
            output-low;
        };
    };

    fp_hbm_init: fp_hbm_init {
        mux {
            pins = "gpio76";
            function = "gpio";
        };

        config {
            pins = "gpio76";
            drive-strength = <2>;
            bias-disable;
            output-low;
        };
    };

    haptic {
        haptic_default: haptic_default {
            mux {
                pins = "gpio69", "gpio44";
                function = "gpio";
            };
    
            config {
                pins = "gpio69", "gpio44";
                drive-strength = <2>;
                bias-pull-up;
                input-enable;
            };
        };
    };

    qupv3_se0_spi_cs1_pins: qupv3_se0_spi_cs1_pins {
        qupv3_se0_spi_cs1_active: qupv3_se0_spi_cs1_active {
            config {
                pins = "gpio8";
                drive-strength = <6>;
                bias-disable;
            };

            mux {
                pins = "gpio8";
                function = "qup_l4";
            };
        };

        qupv3_se0_spi_cs1_sleep: qupv3_se0_spi_cs1_sleep {
            config {
                pins = "gpio8";
                drive-strength = <6>;
                bias-disable;
            };

            mux {
                pins = "gpio8";
                function = "gpio";
            };
        };
    };

    pcie0 {
        /delete-node/ pcie0_3v3_on;
        /delete-node/ pcie0_1v5_on;
    };

    /delete-node/ spkr_i2s_clk_pin;
    /delete-node/ pmx_ts_int_active;
    /delete-node/ pmx_ts_int_suspend;
    /delete-node/ pmx_ts_reset_active;
    /delete-node/ pmx_ts_reset_suspend;
    /delete-node/ pmx_ts_release;
    /delete-node/ ts_mux;
    /delete-node/ ext_bridge_mux;
    /delete-node/ storage_cd;

    /delete-node/ cam_sensor_fisheye_active;
    /delete-node/ cam_sensor_fisheye_suspend;
    /delete-node/ cam_sensor_depth_active;
    /delete-node/ cam_sensor_depth_suspend;
    /delete-node/ max_rst_active;
    /delete-node/ max_rst_suspend;
    /delete-node/ max_6dof_active;
    /delete-node/ max_6dof_suspend;

    /delete-node/ ap2mdm;
    /delete-node/ mdm2ap;

    /delete-node/ pmx_sde;
};

&pm8998_gpios {
    pmx_sde: pmx_sde {
        sde_dsi_active: sde_dsi_active {
            pins = "gpio8";
            function = "normal";
            power-source = <0>;
        };

        sde_dsi_suspend: sde_dsi_suspend {
            pins = "gpio8";
            function = "normal";
            power-source = <0>;
            bias-pull-down;
        };
    };

    /delete-node/ camera_rear_avdd_en;
    /delete-node/ led_bt;
    /delete-node/ led_wifi;
};

&qupv3_se0_spi {
    pinctrl-0 = <&qupv3_se0_spi_active &qupv3_se0_spi_cs1_active>;
    pinctrl-1 = <&qupv3_se0_spi_sleep &qupv3_se0_spi_cs1_sleep>;
    status = "ok";
};

&quat_mi2s_sd3_sleep {
    mux {
        pins = "gpio127";
    };

    config {
        pins = "gpio127";
    };
};

&quat_mi2s_sd3_active {
    mux {
        pins = "gpio127";
    };

    config {
        pins = "gpio127";
    };
};

